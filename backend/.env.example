# Copier ce fichier en .env puis remplacer les valeurs
# Générer une clé : python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=remplace-moi-par-une-longue-cle-aleatoire

# Compte administrateur créé au premier démarrage
ADMIN_USERNAME=admin
ADMIN_PASSWORD=remplace-moi

MONGO_DB=netdata

# Production uniquement : nom de domaine du serveur (HTTPS automatique par Caddy)
DOMAIN=netdata-aziz.duckdns.org